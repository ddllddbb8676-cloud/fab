{
  "name": "semitoon-fab",
  "account_id": "2e7685e9fc3ab45142bb39eaa78a16a6",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "vars": { "FAB_ENVIRONMENT": "production" },
  "routes": [{ "pattern": "fab.semitoon.com", "custom_domain": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/", "/index", "/index.html", "/connection-check", "/connection-check.html", "/api/*"] },
  "durable_objects": { "bindings": [{ "name": "FAB_ROOM", "class_name": "FabRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FabRoom"] }],
  "observability": { "enabled": false }
}

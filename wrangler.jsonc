{
  "name": "semitoon-fab",
  "account_id": "2e7685e9fc3ab45142bb39eaa78a16a6",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "vars": {
    "FAB_ENVIRONMENT": "production",
    "FAB_GOOGLE_CLIENT_ID": "368136192730-jib74nh17msuo03p3p5lp4dvlfi42l71.apps.googleusercontent.com"
  },
  "routes": [{ "pattern": "fab.semitoon.com", "custom_domain": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/", "/index", "/index.html", "/connection-check", "/connection-check.html", "/admin", "/admin/", "/admin.html", "/account", "/account/", "/account.html", "/api/*"] },
  "durable_objects": { "bindings": [{ "name": "FAB_ROOM", "class_name": "FabRoom" }, { "name": "FAB_ANALYTICS", "class_name": "FabAnalytics" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FabRoom"] }, { "tag": "v2-growth-analytics", "new_sqlite_classes": ["FabAnalytics"] }],
  "observability": { "enabled": false }
}
